{
  "expo": {
    "name": "Himaliya Staff",
    "slug": "himaliya-admin",
    "owner": "himaliya_springs",
    "scheme": "himaliya-admin",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF6F8",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.himaliyaspring.admin",
      "versionCode": 8,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#071B33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Himaliya uses your location while you are delivering so customers can follow their rider.",
          "locationAlwaysAndWhenInUsePermission": "Himaliya shares your live location only while you are online with an active delivery.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#078CAC",
          "defaultChannel": "rider-orders-water-drop-vibrate",
          "sounds": [
            "./assets/sounds/water_drop.wav",
            "./assets/sounds/bright_chime.wav",
            "./assets/sounds/soft_bell.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#EEF6F8",
          "dark": {
            "backgroundColor": "#061822"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "targetSdkVersion": 35,
            "compileSdkVersion": 35
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "da11b8ed-d53d-441b-9cd4-9e7e88b04f1e"
      }
    }
  }
}
