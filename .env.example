REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional outside Netlify/Vercel. Used only at build time for canonical metadata and sitemap.xml.
# Supported hosted builds supply their primary production URL automatically.
SITE_URL=

# Netlify server-side environment only. Never prefix this with REACT_APP_.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# --- Web Push (notifications delivered while the app is closed) -------------
# Public half of the VAPID key pair. Safe to expose: it ships to every browser
# and pins each push subscription. When set, the app subscribes devices to
# background push; leave it empty to keep alerts app-open only. Regenerate a
# pair (and the matching private key below) with:
#   node scripts/generate-vapid-keys.js
REACT_APP_VAPID_PUBLIC_KEY=BDXgXZD4W8fD6srJTlqU2rYuFxGcyxW0NxPlCv55SDCDth2fdKxYNXVUJeusC17T_JxU-D4-jUsQHBaollxTkrI

# The following are NOT build env. They are secrets for the send-push Edge
# Function, set with `supabase secrets set KEY=value` (never committed, never
# prefixed with REACT_APP_):
#   VAPID_PRIVATE_KEY     private half of the pair above (keep it like a password)
#   VAPID_SUBJECT         mailto: or https URL identifying the sender (optional)
#   PUSH_DISPATCH_SECRET  shared secret the DB dispatch trigger sends as
#                         x-push-secret; store the same value in
#                         private.push_dispatch_config.dispatch_secret
